{
    "name": "cdd-docs-ui",
    "version": "0.0.4",
    "description": "Zero-framework AOT HTML and Web Component documentation generator for OpenAPI 3.2.0 and Swagger 2.0",
    "main": "./dist/bundle.js",
    "module": "./dist/bundle.js",
    "types": "./dist/src/web-component.d.ts",
    "scripts": {
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src tests",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "docs:check": "typedoc --treatWarningsAsErrors",
        "start": "node dist/cli.js -i example/spec.json -o example/public",
        "serve": "npx serve example/public -l 8082",
        "build": "tsc && esbuild src/web-component.ts --bundle --outfile=dist/bundle.js --format=esm && esbuild src/cli.ts --bundle --outfile=dist/cli.js --platform=node --format=esm",
        "prestart": "npm run build",
        "prepare": "husky"
    },
    "keywords": ["openapi", "swagger", "documentation", "web-components", "aot"],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "express": "^5.2.1",
        "js-yaml": "^4.1.1",
        "marked": "^18.0.4"
    },
    "bin": {
        "cdd-docs-cli": "./dist/cli.js"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^25.9.3",
        "@vitest/coverage-istanbul": "^4.1.7",
        "@vitest/coverage-v8": "^4.1.7",
        "esbuild": "^0.28.0",
        "eslint": "^10.4.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "prettier": "^3.8.3",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7"
    },
    "exports": {
        ".": {
            "types": "./dist/src/web-component.d.ts",
            "import": "./dist/bundle.js",
            "default": "./dist/bundle.js"
        }
    }
}
