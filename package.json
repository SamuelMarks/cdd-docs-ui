        "prestart": "npm run build",
        "prepare": "echo no-husky"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "commander": "^14.0.3",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "fs-extra": "^11.3.5",
        "lit": "^3.3.3",
        "marked": "^18.0.4"
    },
    "bin": {
        "cdd-docs-cli": "./dist/cli.js"
    },
    "devDependencies": {
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^25.9.3",
        "@vitest/coverage-istanbul": "^4.1.7",
        "@vitest/coverage-v8": "^4.1.7",
        "esbuild": "^0.28.0",
        "eslint": "^10.4.0",
        "husky": "^9.1.7",
        "js-yaml": "^4.1.1",
        "jsdom": "^29.1.1",
        "prettier": "^3.8.3",
        "ts-node": "^10.9.2",
